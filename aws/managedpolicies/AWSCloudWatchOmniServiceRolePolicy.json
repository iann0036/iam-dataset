            "aws:RequestTag/CloudWatchOmniManaged": "true",
            "aws:ResourceAccount": "${aws:PrincipalAccount}"
          }
        },
        "Effect": "Allow",
        "Resource": "arn:aws:cloudwatch:*:*:integration/*",
        "Sid": "CreateManagedCloudWatchIntegration"
      },
      {
