          "StringEquals": {
            "aws:ResourceAccount": "${aws:PrincipalAccount}"
          }
        },
        "Effect": "Allow",
        "Resource": "*",
        "Sid": "GetAwsAccountInformation"
      },
      {
        "Action": [
          "iam:GetRole"
        ],
