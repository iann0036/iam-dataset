          }
        },
        "Effect": "Allow",
        "Resource": "arn:aws:iam::*:role/service-role/CloudWatchOmniAWSIntegrationRole-*",
        "Sid": "CreateCloudWatchOmniAWSIntegrationRole"
      },
      {
        "Action": [
          "iam:GetRoleTemplateVersion"
        ],
        "Effect": "Allow",
